# Yüklenen dosyalar klasörü: burada HİÇBİR betik çalıştırılmaz, sadece fotoğraf sunulur.
Options -Indexes

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
