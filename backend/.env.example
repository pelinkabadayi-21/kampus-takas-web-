# Kampüs Takas – ortam değişkenleri örneği (Hafta 9)
#
# Bu dosyayı aynı klasörde ".env" adıyla kopyalayıp kendi anahtarlarınızı yazın.
#   - .env dosyası .gitignore'da olduğu için GitHub'a YÜKLENMEZ.
#   - backend/ klasörü tarayıcıya kapalı olduğu için (.htaccess) dışarıdan okunamaz.
#   - Canlıda (Render) bu değerler dosyaya değil, Render paneli → Environment bölümüne yazılır.
# Bir değeri boş bırakırsanız o özellik kapalı çalışır (site hata vermez).

# Cloudinary (görsel depolama) – Panel → Dashboard → "API Environment variable"
# Biçim: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Brevo (e-posta) – Panel → SMTP & API → API Keys
BREVO_API_KEY=
# Gönderen adres: Brevo panelinde "Senders" bölümünde doğrulanmış olmalı
MAIL_FROM=
MAIL_FROM_NAME=Kampüs Takas

# E-postadaki "Sitede görüntüle" bağlantısı için (sonunda / olmadan)
# XAMPP: http://localhost/kampus-takas-web-   ·   Render: https://<servis-adı>.onrender.com
SITE_URL=

# Sadece backend/tests/api_canli_test.php için: test e-postası bu adrese gider
MAIL_TEST_TO=
